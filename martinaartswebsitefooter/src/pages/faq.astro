---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

const groups = [
  {
    title: 'Metingen & levering',
    items: [
      { q: 'Hoe lang duurt een meting gemiddeld?', a: 'Dat hangt af van de omvang van het project — bij de offerte geven wij altijd een concrete inschatting voor uw situatie.' },
      { q: 'Welk bestandsformaat ontvang ik na afloop?', a: 'Dat stemmen wij vooraf met u af — denk aan CAD-tekeningen, puntenbestanden of een PDF-rapport, afhankelijk van de dienst.' },
      { q: 'In welk coördinatensysteem levert u de data aan?', a: 'Standaard in RD New / NAP, het Nederlandse coördinaten- en hoogtestelsel. Een ander systeem is in overleg mogelijk.' },
    ],
  },
  {
    title: 'Werkgebied & planning',
    items: [
      { q: 'Werken jullie ook buiten het vaste werkgebied?', a: 'GEGEVEN NOG TE BEVESTIGEN — vraag dit gerust na bij het aanvragen van een offerte.' },
      { q: 'Hoe snel kan een meting worden ingepland?', a: 'GEGEVEN NOG TE BEVESTIGEN — de reactietermijn hangt af van de huidige planning; neem contact op voor de actuele beschikbaarheid.' },
      { q: 'Kan ik een offerte aanvragen zonder verplichting?', a: 'Ja — een offerte aanvragen is altijd vrijblijvend.' },
    ],
  },
  {
    title: 'Apparatuur & nauwkeurigheid',
    items: [
      { q: 'Welke apparatuur gebruiken jullie?', a: 'RTK-GPS, robotgestuurde total stations, digitale waterpassen en 3D-laserscanners — zie de apparatuurpagina voor een volledig overzicht.' },
      { q: 'Hoe nauwkeurig zijn jullie metingen?', a: 'GEGEVEN NOG TE BEVESTIGEN — de haalbare nauwkeurigheid hangt af van de gekozen methode en het type project; wij lichten dit toe bij de offerte.' },
      { q: 'Kunnen jullie ook bestaande bouwwerken inscannen voor BIM?', a: 'Ja, met 3D-laserscanning leggen wij bestaande situaties vast als puntenwolk, bruikbaar als basis voor BIM-modellen.' },
    ],
  },
];
---
<Layout
  title="Veelgestelde vragen | Martin Aarts"
  description="Antwoorden op de meest gestelde vragen over metingen, uitzetwerk, levertijden en apparatuur."
>
  <section class="page-head">
    <span class="eyebrow">Veelgestelde vragen</span>
    <h1>Nog twijfels?</h1>
    <p class="lead">Staat uw vraag er niet bij? Neem gerust contact op — wij denken graag mee.</p>
  </section>

  <section class="faq-groups">
    {groups.map((group) => (
      <div class="faq-group">
        <h2>{group.title}</h2>
        <FaqAccordion items={group.items} />
      </div>
    ))}
  </section>

  <div class="ctaband">
    <span class="eyebrow" style="justify-content:center;">Nog een vraag?</span>
    <h2>Neem gerust contact op.</h2>
    <div class="cta-actions">
      <Button href="/contact" variant="accent">Offerte aanvragen</Button>
      <Button href="https://wa.me/31644708530" target="_blank" rel="noopener noreferrer" variant="outline-on-dark">WhatsApp ons</Button>
    </div>
  </div>
</Layout>

<style>
  .page-head {
    padding: 56px var(--gutter) 40px;
    max-width: 700px;
  }
  .page-head h1 {
    font-size: 46px;
    margin-top: 12px;
  }
  .lead {
    font-size: 17px;
    color: var(--color-ink-soft);
    margin: 18px 0 0;
  }

  .faq-groups {
    padding: 0 var(--gutter) 96px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .faq-group h2 {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 20px;
    text-transform: none;
    letter-spacing: 0;
    margin-bottom: 8px;
    color: var(--color-accent-hover);
  }

  .ctaband {
    background: var(--color-ink);
    color: #fff;
    padding: 64px var(--gutter);
    text-align: center;
  }
  .ctaband h2 {
    color: #fff;
    font-size: 36px;
    margin: 14px 0 26px;
  }
  .cta-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 700px) {
    .page-head h1 { font-size: 32px; }
  }
</style>
