---
import Icon from './Icon.astro';

interface NavLink {
  label: string;
  href: string;
}

// Voorlopige navigatie — komt overeen met de goedgekeurde sitemap.
// Sommige doelen bestaan nog niet als volledige pagina (Fase 1 bouwt
// alleen het fundament); ze linken al wel naar de juiste route.
const navLinks: NavLink[] = [
  { label: 'Diensten', href: '/diensten' },
  { label: 'Projecten', href: '/projecten' },
  { label: 'Apparatuur', href: '/apparatuur' },
  { label: 'Over ons', href: '/over-ons' },
  { label: 'FAQ', href: '/faq' },
];
---
<header class="header">
  <a href="/" class="brand">
    <img src="/images/brand/logo-mark-128.png" alt="" width="42" height="42" class="mark" />
    <span class="brand-text">
      <span class="brand-name">Martin Aarts</span>
      <span class="brand-sub mono">GWW · Agrarisch · Transport</span>
    </span>
  </a>

  <nav class="nav" aria-label="Hoofdmenu">
    {navLinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>

  <div class="header-cta">
    <a href="/contact" class="btn btn-outline">Offerte aanvragen</a>
    <a
      href="https://wa.me/31644708530"
      class="btn-wa"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Stuur een bericht via WhatsApp"
    >
      <Icon name="wa" size={20} />
    </a>
  </div>

  <button class="menu-toggle" type="button" aria-label="Menu openen" aria-expanded="false" aria-controls="mobile-nav">
    <Icon name="menu" size={20} />
    <Icon name="close" size={20} class="icon-close" />
  </button>
</header>

<div class="mobile-nav-overlay" id="mobile-nav-overlay" hidden></div>
<nav class="mobile-nav" id="mobile-nav" aria-label="Mobiel menu" hidden>
  {navLinks.map((link) => (
    <a href={link.href}>{link.label}</a>
  ))}
  <a href="/contact" class="mobile-nav-cta">Offerte aanvragen</a>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const overlay = document.getElementById('mobile-nav-overlay');
  const nav = document.getElementById('mobile-nav');

  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.classList.remove('is-open');
    overlay?.setAttribute('hidden', '');
    nav?.setAttribute('hidden', '');
  }

  function openMenu() {
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.classList.add('is-open');
    overlay?.removeAttribute('hidden');
    nav?.removeAttribute('hidden');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });
  overlay?.addEventListener('click', closeMenu);
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 62;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 var(--gutter);
    height: 84px;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
  }
  .brand:hover {
    color: inherit;
  }

  .mark {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    text-transform: uppercase;
  }
  .brand-sub {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--color-ink-faint);
  }

  .nav {
    display: flex;
    gap: 34px;
  }
  .nav a {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .nav a[aria-current='page'] {
    color: var(--color-ink);
  }

  .header-cta {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 22px;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 14.5px;
  }
  .btn-outline {
    border: 1.5px solid var(--color-ink);
    color: var(--color-ink);
  }
  .btn-outline:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .btn-wa {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-whatsapp);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }
  .btn-wa:hover {
    color: #fff;
    opacity: 0.88;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: 1.5px solid var(--color-ink);
    border-radius: var(--radius-sm);
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    cursor: pointer;
  }
  .menu-toggle :global(.icon-close) {
    display: none;
  }
  .menu-toggle.is-open :global(.icon:not(.icon-close)) {
    display: none;
  }
  .menu-toggle.is-open :global(.icon-close) {
    display: block;
  }

  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(26, 26, 26, 0.55);
    z-index: 60;
  }
  .mobile-nav {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 78%;
    max-width: 340px;
    background: var(--gradient-graphite);
    z-index: 61;
    padding: 100px 28px 40px;
    flex-direction: column;
    gap: 4px;
  }
  .mobile-nav[hidden] {
    display: none;
  }
  .mobile-nav:not([hidden]) {
    display: flex;
  }
  .mobile-nav a {
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    text-transform: uppercase;
    padding: 12px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .mobile-nav-cta {
    margin-top: 20px;
    border-bottom: none !important;
    color: var(--color-accent) !important;
  }

  @media (max-width: 900px) {
    .nav,
    .header-cta {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
    .header {
      height: 64px;
    }
    .mark {
      width: 34px;
      height: 34px;
    }
    .brand-name {
      font-size: 17px;
    }
  }
</style>
