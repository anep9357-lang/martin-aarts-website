---
// Generieke kaart. Standaard licht (var(--color-surface)) — het
// grafiet-accent hoort in een klein icon-badge binnenin de kaart, niet
// als achtergrond van de hele kaart. Zie StyleGuide-canvas, sectie
// "Hiërarchie" voor waarom.
interface Props {
  class?: string;
  hoverDark?: boolean;
}

const { class: className = '', hoverDark = false } = Astro.props;
---
<div class:list={['card', { 'card-hover-dark': hoverDark }, className]}>
  <slot />
</div>

<style>
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: background 0.2s, color 0.2s;
  }

  .card-hover-dark:hover {
    background: var(--gradient-graphite);
    color: #fff;
  }
  /* h1-h3 krijgen elders een expliciete ink-kleur (zie base.css) die
     anders de overerving van #fff hierboven zou blokkeren */
  .card-hover-dark:hover :global(h1),
  .card-hover-dark:hover :global(h2),
  .card-hover-dark:hover :global(h3) {
    color: #fff;
  }
</style>
