---
// Eén sprite met alle lijniconen van het project — 24px raster, één
// stroke-gewicht. Wordt één keer in Layout.astro gerenderd; individuele
// iconen worden elders geplaatst met <Icon name="..." />.
---
<svg style="display:none" aria-hidden="true">
  <symbol id="ic-gnss" viewBox="0 0 24 24"><circle cx="12" cy="20" r="1.3" fill="currentColor" stroke="none"/><line x1="12" y1="18.5" x2="12" y2="12.5"/><path d="M8.5 12.2a3.7 3.7 0 0 1 7 0"/><path d="M6 9.3a7 7 0 0 1 12 0"/></symbol>
  <symbol id="ic-total-station" viewBox="0 0 24 24"><line x1="12" y1="10" x2="4" y2="22"/><line x1="12" y1="10" x2="20" y2="22"/><line x1="12" y1="10" x2="12" y2="22"/><rect x="7.3" y="2.5" width="9.4" height="6.5" rx="1.2"/><circle cx="16" cy="5.75" r="1.2" fill="currentColor" stroke="none"/></symbol>
  <symbol id="ic-scanner" viewBox="0 0 24 24"><rect x="8" y="15" width="8" height="6.5" rx="1.2"/><circle cx="12" cy="11" r="2.1"/><path d="M6.8 7.8a7.3 7.3 0 0 1 10.4 0"/><path d="M4.2 5a11 11 0 0 1 15.6 0"/></symbol>
  <symbol id="ic-pointcloud" viewBox="0 0 24 24"><circle cx="6" cy="6" r="1"/><circle cx="12" cy="6" r="1"/><circle cx="18" cy="6" r="1"/><circle cx="6" cy="12" r="1"/><circle cx="18" cy="12" r="1"/><circle cx="6" cy="18" r="1"/><circle cx="12" cy="18" r="1"/><circle cx="18" cy="18" r="1"/><circle cx="12" cy="12" r="1.8" fill="currentColor" stroke="none"/></symbol>
  <symbol id="ic-field" viewBox="0 0 24 24"><line x1="2" y1="5" x2="22" y2="5"/><line x1="2" y1="10" x2="22" y2="10"/><line x1="2" y1="15" x2="22" y2="15"/><line x1="2" y1="20" x2="22" y2="20"/></symbol>
  <symbol id="ic-ruler" viewBox="0 0 24 24"><rect x="2" y="9" width="20" height="6" rx="1"/><line x1="6" y1="9" x2="6" y2="12"/><line x1="10" y1="9" x2="10" y2="12"/><line x1="14" y1="9" x2="14" y2="12"/><line x1="18" y1="9" x2="18" y2="12"/></symbol>
  <symbol id="ic-doc" viewBox="0 0 24 24"><rect x="5" y="2.5" width="14" height="19" rx="1.2"/><line x1="8" y1="7.5" x2="16" y2="7.5"/><line x1="8" y1="11" x2="16" y2="11"/><line x1="8" y1="14.5" x2="13" y2="14.5"/></symbol>
  <symbol id="ic-shield" viewBox="0 0 24 24"><path d="M12 2.5l7 3v5.5c0 5-3 8.5-7 10.5-4-2-7-5.5-7-10.5V5.5z"/><polyline points="8.7,12 11,14.3 15.3,9.3"/></symbol>
  <symbol id="ic-pin" viewBox="0 0 24 24"><path d="M12 22s7-7.5 7-12.5a7 7 0 0 0-14 0C5 14.5 12 22 12 22z"/><circle cx="12" cy="9.5" r="2.3"/></symbol>
  <symbol id="ic-arrow" viewBox="0 0 24 24"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14,6 20,12 14,18"/></symbol>
  <symbol id="ic-chevron" viewBox="0 0 24 24"><polyline points="6,9 12,15 18,9"/></symbol>
  <symbol id="ic-mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="1.4"/><polyline points="3,6.5 12,13 21,6.5"/></symbol>
