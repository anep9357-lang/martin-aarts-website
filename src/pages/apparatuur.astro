---
import Layout from '../layouts/Layout.astro';
import PhaseNotice from '../components/PhaseNotice.astro';
---
<Layout
  title="Apparatuur | Martin Aarts"
  description="De instrumenten waarmee Martin Aarts meet en uitzet: GNSS, Total Station, 3D-laserscanning en meer."
>
  <section class="page-head">
    <span class="eyebrow">Apparatuur</span>
    <h1>Instrumenten die het verschil maken.</h1>
  </section>
  <PhaseNotice phase="Fase 3" />
</Layout>

<style>
  .page-head { padding: 56px var(--gutter) 8px; }
  .page-head h1 { font-size: 46px; margin-top: 12px; }
</style>
