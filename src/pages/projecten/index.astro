---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---
<Layout
  title="Projecten | Martin Aarts"
  description="Een selectie van projecten — van uitdaging tot resultaat. Landmeetkundige case studies binnen GWW, bouw en agrarische projecten."
>
  <section class="page-head">
    <span class="eyebrow">Projecten</span>
    <h1>Van uitdaging tot resultaat.</h1>
    <p class="lead">Elk project begint met een vraagstuk en eindigt met bruikbare meetdata. Hieronder een selectie van hoe dat er in de praktijk uitziet.</p>
  </section>

  <section class="proj-grid">
    {projects.map((p) => <ProjectCard project={p} />)}
  </section>
</Layout>

<style>
  .page-head {
    padding: 56px var(--gutter) 40px;
    max-width: 760px;
  }
  .page-head h1 {
    font-size: 46px;
    margin-top: 12px;
  }
  .lead {
    font-size: 17px;
    color: var(--color-ink-soft);
    margin: 18px 0 0;
  }
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    padding: 0 var(--gutter) 96px;
  }
  @media (max-width: 1100px) {
    .proj-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 700px) {
    .proj-grid {
      grid-template-columns: 1fr;
    }
    .page-head h1 {
      font-size: 34px;
    }
  }
</style>
