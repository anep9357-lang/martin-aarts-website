---
// Toont een echte foto als die er is; anders een eerlijke placeholder
// (gestippelde rand + label) — nooit een nepfoto voorwenden als echt.
interface Props {
  src?: string;
  alt?: string;
  placeholderLabel?: string;
  aspectRatio?: string;
  class?: string;
  /** Zet op true voor de foto die direct zichtbaar is bij het laden van de
      pagina (bijv. de hero) — voorkomt dat lazy-loading de LCP vertraagt. */
  priority?: boolean;
}

const {
  src,
  alt = '',
  placeholderLabel = 'Echte foto volgt',
  aspectRatio = '4 / 3',
  class: className = '',
  priority = false,
} = Astro.props;
---
{src ? (
  <div class:list={['photo-frame', className]} style={`aspect-ratio:${aspectRatio}`}>
    <img
      src={src}
      alt={alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      width="1600"
      height="1200"
    />
  </div>
) : (
  <div class:list={['photo-frame', 'photo-frame-empty', className]} style={`aspect-ratio:${aspectRatio}`}>
    <span class="mono">{placeholderLabel}</span>
  </div>
)}

<style>
  .photo-frame {
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-muted);
  }
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo-frame-empty {
    border: 1.5px dashed var(--color-ink-faint);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
  }
  .photo-frame-empty .mono {
    font-size: 10px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
</style>
