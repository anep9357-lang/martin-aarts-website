---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

// Formulierverwerking via Formspree (gekozen omdat de site statisch is en
// onafhankelijk moet werken van de uiteindelijke hosting — zie PLAN.md).
// TODO: vervang door het echte formulier-ID zodra het Formspree-account
// is aangemaakt (gratis, ~2 minuten: formspree.io → nieuw formulier →
// e-mailadres info@martinaarts.xyz bevestigen → ID hierheen kopiëren).
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/TBC';

const services = ['Topografische meting', 'Uitzetwerk', 'As-built', '3D-laserscanning', 'Agrarisch', 'Anders'];

const miniFaq = [
  'Hoe lang duurt een meting gemiddeld?',
  'Welk bestandsformaat ontvang ik na afloop?',
  'Werken jullie ook buiten het vaste werkgebied?',
];
---
<Layout
  title="Contact | Martin Aarts"
  description="Vraag een offerte aan of neem direct contact op via WhatsApp of e-mail."
>
  <section class="c-hero">
    <span class="eyebrow">Contact</span>
    <h1>Vraag een<br />offerte aan.</h1>
    <p>Beschrijf uw project — wij nemen zo snel mogelijk contact met u op. Liever direct schakelen? Stuur ons een bericht via WhatsApp.</p>
  </section>

  <div class="c-wrap">
    <form class="form-card" id="quote-form" data-endpoint={FORMSPREE_ENDPOINT}>
      <div class="form-row">
        <div class="field"><label for="f-name">Naam</label><input id="f-name" name="naam" type="text" placeholder="Uw volledige naam" required /></div>
        <div class="field"><label for="f-company">Bedrijf <span class="hint">(optioneel)</span></label><input id="f-company" name="bedrijf" type="text" placeholder="Bedrijfsnaam" /></div>
      </div>
      <div class="form-row">
        <div class="field"><label for="f-email">E-mail</label><input id="f-email" name="email" type="email" placeholder="naam@bedrijf.nl" required /></div>
        <div class="field"><label for="f-phone">Telefoon</label><input id="f-phone" name="telefoon" type="tel" placeholder="06 12 34 56 78" /></div>
      </div>
      <div class="field full" style="margin-bottom:20px;">
        <label id="dienst-label">Type dienst</label>
        <input type="hidden" name="dienst" id="f-dienst" />
        <div class="svc-pills" role="radiogroup" aria-labelledby="dienst-label">
          {services.map((s, i) => (
            <button type="button" class="svc-pill" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-value={s}>{s}</button>
          ))}
        </div>
      </div>
      <div class="form-row">
        <div class="field"><label for="f-location">Locatie project</label><input id="f-location" name="locatie" type="text" placeholder="Plaats / adres" /></div>
        <div class="field"><label for="f-period">Gewenste periode</label><input id="f-period" name="periode" type="text" placeholder="Bijv. binnen 2 weken" /></div>
      </div>
      <div class="field full" style="margin-bottom:20px;">
        <label for="f-message">Omschrijving van het project</label>
        <textarea id="f-message" name="bericht" placeholder="Vertel kort over uw project, de situatie en wat u nodig heeft..." required></textarea>
      </div>
      <div class="field full" style="margin-bottom:8px;">
        <label for="f-files">Bijlage <span class="hint">(optioneel — situatieschets, PDF, foto's, CAD-bestand)</span></label>
        <input id="f-files" name="bijlage" type="file" multiple accept=".pdf,.jpg,.jpeg,.png,.dwg,.dxf" />
      </div>
      <label class="consent">
        <input type="checkbox" name="privacy_akkoord" required />
        <span>Ik ga akkoord met de <a href="/privacyverklaring">privacyverklaring</a>.</span>
      </label>
      <button type="submit" class="btn btn-primary form-submit">Offerte aanvragen</button>
      <p class="form-note">Reactietermijn: <span class="mono">binnen 24 uur</span>.</p>
      <p class="form-status" id="form-status" role="status" hidden></p>
    </form>

    <div>
      <div class="side">
        <a class="side-item" href="mailto:info@martinaarts.xyz"><Icon name="mail" size={22} /><div><h4>E-mail</h4><p>info@martinaarts.xyz</p></div></a>
        <a class="side-item dark" href="https://wa.me/31644708530?text=Hallo%20Martin%2C%20ik%20wil%20graag%20een%20vrijblijvende%20offerte%20aanvragen%20voor%20een%20project." target="_blank" rel="noopener noreferrer"><Icon name="wa" size={22} /><div><h4>WhatsApp — snelste reactie</h4><p>+31 6 44 70 85 30</p></div></a>
        <div class="side-item"><Icon name="pin" size={22} /><div><h4>Adres</h4><p>Lisdodde 5<br />4731 WP Oudenbosch</p></div></div>
        <div class="side-item"><Icon name="clock" size={22} /><div><h4>Bereikbaarheid</h4><p class="mono tbc" style="font-size:11px;">GEGEVEN NOG TE BEVESTIGEN</p></div></div>
      </div>
      <div class="map">
        <iframe
          title="Kaart — Lisdodde 5, Oudenbosch"
          src="https://www.google.com/maps?q=Lisdodde+5,+4731+WP+Oudenbosch&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>

  <section class="faq-mini">
    <h2>Voordat u contact opneemt</h2>
    {miniFaq.map((q) => (
      <a href="/faq" class="faq-row">
        <h4>{q}</h4>
        <Icon name="chevron" size={17} class="faq-mini-chevron" />
      </a>
    ))}
  </section>
</Layout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.svc-pill');
  const dienstInput = document.getElementById('f-dienst') as HTMLInputElement | null;
  if (dienstInput && pills.length) dienstInput.value = pills[0].dataset.value ?? '';

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => p.setAttribute('aria-checked', 'false'));
      pill.setAttribute('aria-checked', 'true');
      if (dienstInput) dienstInput.value = pill.dataset.value ?? '';
    });
  });

  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const endpoint = form.dataset.endpoint;
    if (!status) return;

    status.hidden = false;
    status.textContent = 'Bezig met versturen...';
    status.className = 'form-status';

    try {
      const res = await fetch(endpoint!, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        status.textContent = 'Bedankt! Uw aanvraag is verstuurd — wij nemen zo snel mogelijk contact met u op.';
        status.className = 'form-status success';
        form.reset();
      } else {
        throw new Error('submit failed');
      }
    } catch {
      status.textContent = 'Er ging iets mis bij het versturen. Probeer het opnieuw, of neem direct contact op via WhatsApp of info@martinaarts.xyz.';
      status.className = 'form-status error';
    }
  });
</script>

<style>
  .c-hero { padding: 64px var(--gutter) 0; max-width: 700px; }
  .c-hero h1 { font-size: 52px; margin-top: 14px; }
  .c-hero p { color: var(--color-ink-soft); font-size: 16.5px; margin-top: 16px; }

  .c-wrap {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 56px;
    padding: 56px var(--gutter) 100px;
    align-items: start;
  }

  .form-card {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 40px;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  .field { display: flex; flex-direction: column; gap: 8px; }
  .field.full { grid-column: 1 / -1; }
  .field label { font-size: 13px; font-weight: 700; color: var(--color-ink); }
  .field .hint { font-size: 11.5px; color: var(--color-ink-faint); font-weight: 400; }
  .field input, .field textarea {
    font-family: var(--font-body);
    font-size: 14.5px;
    padding: 12px 14px;
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .field input:focus, .field textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }
  .field textarea { resize: vertical; min-height: 110px; }

  .svc-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .svc-pill {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--color-line);
    background: none;
    color: var(--color-ink-soft);
    cursor: pointer;
  }
  .svc-pill[aria-checked='true'] {
    background: var(--color-ink);
    color: #fff;
    border-color: var(--color-ink);
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 12.5px;
    color: var(--color-ink-soft);
    margin-top: 6px;
    cursor: pointer;
  }
  .consent input { margin-top: 2px; accent-color: var(--color-accent); flex-shrink: 0; }
  .consent a { color: var(--color-accent-hover); text-decoration: underline; }

  .form-submit { width: 100%; padding: 16px; margin-top: 14px; font-size: 15px; }
  .form-note { font-size: 12px; color: var(--color-ink-faint); margin: 14px 0 0; text-align: center; }
  .form-status { margin: 14px 0 0; padding: 12px 16px; border-radius: var(--radius-sm); font-size: 13.5px; text-align: center; background: var(--color-surface-muted); }
  .form-status.success { background: var(--color-success-tint); color: var(--color-success); }
  .form-status.error { background: var(--color-error-tint); color: var(--color-error); }

  .side {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .side-item { background: var(--color-surface); padding: 24px 26px; display: flex; gap: 16px; align-items: flex-start; }
  .side-item :global(svg) { color: var(--color-accent); flex-shrink: 0; margin-top: 2px; }
  .side-item h4 { font-family: var(--font-body); font-weight: 800; font-size: 14.5px; margin: 0 0 4px; text-transform: none; }
  .side-item p { font-size: 13.5px; color: var(--color-ink-soft); margin: 0; line-height: 1.6; }
  .side-item.dark { background: var(--gradient-graphite); color: #fff; }
  .side-item.dark h4 { color: #fff; }
  .side-item.dark p { color: rgba(255, 255, 255, 0.7); }

  .map { height: 220px; border-radius: var(--radius-md); margin-top: 20px; overflow: hidden; border: 1px solid var(--color-line); }
  .map iframe { width: 100%; height: 100%; border: 0; }

  .faq-mini { padding: 0 var(--gutter) 90px; }
  .faq-mini h2 { font-size: 28px; margin-bottom: 24px; }
  .faq-row {
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 900px;
  }
  .faq-row h4 { font-family: var(--font-body); font-weight: 700; font-size: 15px; margin: 0; text-transform: none; }
  .faq-row:hover h4 { color: var(--color-accent); }
  .faq-row :global(.faq-mini-chevron) { color: var(--color-accent); transform: rotate(-90deg); }

  @media (max-width: 900px) {
    .c-hero h1 { font-size: 36px; }
    .c-wrap { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>
